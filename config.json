{
  "host": "127.0.0.1",
  "port": 8080,
  "ollama_url": "http://localhost:11434",
  "db_path": "./data/nativestudio.db",
  "default_model": "nativestudio:coder",
  "chat_model": "nativestudio:coder",
  "summary_model": "nativestudio:coder",
  "embedding_model": "nomic-embed-text",
  "index_batch_size": 10,
  "maximum_file_size_bytes": 1048576,
  "ollama_concurrency": 2,
  "embedding_concurrency": 4,
  "max_agent_tool_steps": 15,
  "context": {
    "yellow_threshold": 0.6,
    "red_threshold": 0.8,
    "keep_recent_messages": 10,
    "summarize_using_model": "nativestudio:coder"
  },
  "filesystem": {
    "root_dir": "./workspace",
    "allowed_extensions": [".php", ".go", ".mod", ".sum", ".js", ".jsx", ".ts", ".tsx", ".py", ".md", ".json", ".yaml", ".yml", ".sql", ".xml", ".toml", ".txt", ".css", ".scss", ".sass", ".less", ".html", ".htm", ".svg", ".sh", ".bash", ".zsh", ".rb", ".rs", ".java", ".kt", ".swift", ".c", ".h", ".cpp", ".hpp", ".cs", ".vue", ".svelte", ".ini", ".conf", ".cfg", ".env", ".csv", ".tsv", ".log", ".lock", ".gitignore", ".dockerignore", ".editorconfig", ".graphql", ".proto", ".ipynb"]
  }
}
